    },
    {
      "atMs": 3003,
      "action": {
        "type": "event",
        "agent": "codex",
        "event": "Stop",
        "id": "4",
        "payload": {
          "hook_event_name": "Stop",
          "session_id": "session",
          "turn_id": "turn"
        }
      },
      "expect": {
        "state": "done",
        "certainty": "observed",
        "dominantAgent": "codex",
        "pendingCount": 0,
        "formId": "codex"
      }
    },
    {
      "atMs": 6003,
      "action": {
        "type": "tick"
      },
      "expect": {
        "state": "idle",
        "certainty": "observed",
        "dominantAgent": "codex",
        "pendingCount": 0,
        "formId": "codex"
      }
