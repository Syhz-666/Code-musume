      },
      "expect": {
        "state": "working",
        "certainty": "observed",
        "dominantAgent": "claude-code",
        "pendingCount": 0,
        "formId": "claude",
        "activeSessions": 2,
        "sessions": [
          {
            "agent": "claude-code",
            "state": "working",
            "pendingCount": 0
          },
          {
            "agent": "codex",
