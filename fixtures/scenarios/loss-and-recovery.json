{
  "schemaVersion": 1,
  "id": "loss-and-recovery",
  "description": "丢失事件降低可信度，明确的新轮次恢复该会话，累计丢失数保留。",
  "provenance": "synthetic",
  "sourceVersions": {
    "codex": "0.162.0-alpha.17.2"
  },
  "steps": [
    {
      "atMs": 0,
      "action": {
        "type": "event",
        "agent": "codex",
        "event": "PreToolUse",
        "id": "1",
        "payload": {
          "hook_event_name": "PreToolUse",
          "session_id": "session",
          "turn_id": "turn",
          "tool_use_id": "one"
        }
      },
      "expect": {
        "state": "working",
        "certainty": "observed",
        "dominantAgent": "codex",
        "pendingCount": 0,
        "formId": "codex"
      }
    },
    {
      "atMs": 1,
      "action": {
        "type": "lost",
        "count": 3
      },
      "expect": {
        "state": "working",
        "certainty": "stale",
        "dominantAgent": "codex",
        "pendingCount": 0,
        "formId": "codex",
        "missedEvents": 3
      }
    },
    {
      "atMs": 2,
      "action": {
        "type": "event",
        "agent": "codex",
        "event": "UserPromptSubmit",
        "id": "2",
        "payload": {
          "hook_event_name": "UserPromptSubmit",
          "session_id": "session",
          "turn_id": "new"
        }
      },
      "expect": {
        "state": "thinking",
        "certainty": "observed",
        "dominantAgent": "codex",
        "pendingCount": 0,
        "formId": "codex",
        "missedEvents": 3
      }
    },
    {
      "atMs": 3,
      "action": {
        "type": "reset"
      },
      "expect": {
        "state": "idle",
        "certainty": "unknown",
        "dominantAgent": null,
        "pendingCount": 0,
        "formId": "default",
        "missedEvents": 0,
        "activeSessions": 0
      }
    }
  ]
}
