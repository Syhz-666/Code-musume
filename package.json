{
  "name": "code-musume",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "pnpm --filter @code-musume/pet dev",
    "tauri": "pnpm --filter @code-musume/pet tauri",
    "build": "pnpm --filter @code-musume/pet build",
    "test": "pnpm -r test",
    "test:replay": "node tools/desktop.mjs replay",
    "test:ui": "node tools/desktop.mjs ui",
    "test:tools": "node --test tools/*.test.mjs",
    "diagnostics": "node tools/diagnostic-report.mjs",
    "verify:desktop": "node tools/desktop.mjs verify",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome format --write .",
    "contracts:generate": "cargo run -p code-musume-contracts --features bindings --bin export-bindings",
    "verify": "pnpm typecheck && pnpm test && pnpm lint && cargo test --workspace && cargo clippy --workspace --all-targets -- -D warnings",
    "package:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File tools/package-windows.ps1"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15"
  }
}
